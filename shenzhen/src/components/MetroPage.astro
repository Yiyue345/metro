---
import MetroMap from './MetroMap.astro';
import CityMenu from './CityMenu.astro';
import type { MetroCityDataset } from '../data/metro-city';
import { validateVisitedStations } from '../data/validate-visited.mjs';
import '../styles/tokens.css';
import '../styles/global.css';
interface Props { dataset: MetroCityDataset }
const { dataset } = Astro.props;
const { city, stations, visitedStations } = dataset;
const visitedCount = validateVisitedStations(visitedStations, new Set(stations.map(station => station.id))).length;
const visitedPercent = (visitedCount / stations.length * 100).toFixed(1);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content={`${city.name}地铁线路地图，搜索和查看每个地铁站。`} />
    <title>{city.name} / 地铁足迹</title>
  </head>
  <body>
    <header class="masthead">
      <div class="brand">
        <CityMenu currentCity={city.id} />
        <span class="brand-city">{city.name}</span><span class="brand-slash">/</span><span class="brand-title">地铁足迹</span>
      </div>
      <span class="visit-summary">已去过 <span>（{visitedCount} / {stations.length}）{visitedPercent}%</span> 的地铁站</span>
    </header>
    <main><MetroMap dataset={dataset} /></main>
  </body>
</html>
