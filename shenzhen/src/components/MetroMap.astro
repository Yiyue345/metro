---
import { shenzhenDataset, type MetroCityDataset } from '../data/metro-city';
import StationSymbol from './StationSymbol.astro';
import { validateVisitedStations } from '../data/validate-visited.mjs';
import { validateStationNotes } from '../data/validate-station-notes.mjs';
import 'maplibre-gl/dist/maplibre-gl.css';
interface Props { dataset?: MetroCityDataset }
const { dataset = shenzhenDataset } = Astro.props;
const { city, mapMeta, stations, plannedStations, lines, symbols, routes, vectorBasemap, labels, englishNames, visitedStations, coordinates, stationNotes, basemap, operatorsByStation, lineNames } = dataset;
const stationIds = new Set(stations.map(station => station.id));
validateVisitedStations(visitedStations, stationIds);
const allStations = [...stations, ...plannedStations];
validateStationNotes(stationNotes, new Set(allStations.map(station => station.id)));
const plannedById = new Map(plannedStations.map(station => [station.id, station]));
interface SymbolGeometry { parts: { x: number; y: number; width: number; height: number; angle: number; lines: string[]; transfer: boolean }[]; connections?: { x1: number; y1: number; x2: number; y2: number; points?: string; kind: string }[] }
const geometries = symbols as Record<string, SymbolGeometry>;
const colors = new Map(lines.map(line => [line.id, line.color]));
const geography = vectorBasemap.layers as { kind: string; fill: string; stroke?: string; strokeWidth?: number; paths: string[] }[];
const lineBadgeWidth = (id: string) => /^\d{2}$/.test(id) ? 245 : 200;
const bilingualStations = allStations.map(station => ({ ...station, englishName: plannedById.get(station.id)?.englishName ?? englishNames[station.id] ?? '' }));
// Notes remain plain text even when they contain HTML script-closing sequences.
const metroPayload = JSON.stringify({ stations: bilingualStations, lines, meta: mapMeta, visitedStations, coordinates, city, stationNotes, basemap, operatorsByStation, lineNames }).replace(/</g, '\\u003c');
function englishLines(name: string) {
  const result: string[] = [];
  for (const word of name.split(' ')) {
    if (result.length && result[result.length - 1].length + word.length < 24) result[result.length - 1] += ` ${word}`;
    else result.push(word);
  }
  return result;
}
---
<section class="map-workspace" data-map-mode="geographic" aria-label={`${city.name}地铁交互地图`}>
  <svg id="metro-map" role="group" aria-label={`${city.name}地铁站点地图，可拖动和缩放`} tabindex="0" viewBox={`0 0 ${mapMeta.width} ${mapMeta.height}`}>
    <g class="vector-layer geography-layer" aria-hidden="true">
      {geography.map(region => <g class={`geography-${region.kind}`} fill={region.fill} stroke={region.stroke} stroke-width={region.strokeWidth} stroke-linecap="round" stroke-linejoin="round" fill-rule="nonzero">{region.paths.map(path => <path d={path} />)}</g>)}
    </g>
    <g class="vector-layer routes-layer" aria-hidden="true">
      {routes.map(route => <g class="metro-route" data-route={route.id} stroke={route.color} stroke-width={route.width} fill="none">{route.paths.map(path => <path d={path} />)}</g>)}
    </g>
    <g id="station-hotspots">
      {allStations.map((station, index) => {
        const geometry: SymbolGeometry = (plannedById.get(station.id)?.symbol ?? geometries[station.id]) ?? { parts: [{ x: station.x, y: station.y, width: 10, height: 10, angle: 0, lines: station.lines, transfer: station.lines.length > 1 }] };
        return <g class="station-hotspot" data-station={station.id} tabindex="-1" role="button" aria-disabled="true" aria-label={station.name.endsWith('站') ? station.name : `${station.name}站`}>
          <title>{station.name}</title>
          {geometry.connections?.map(connection => <polyline class:list={['station-connection', connection.kind]} points={connection.points ?? `${connection.x1},${connection.y1} ${connection.x2},${connection.y2}`} />)}
          {(['border', 'keyline', 'fill'] as const).map(layer => geometry.parts.map((part, partIndex) => <StationSymbol part={part} partIndex={partIndex} colors={colors} layer={layer} gradientId={`station-gradient-${index}-${partIndex}`} />))}
        </g>;
      })}
    </g>
    <g class="vector-layer labels-layer" aria-hidden="true">
      {allStations.map(station => {
        const label = (plannedById.get(station.id)?.label ?? labels[station.id]) ?? { x: station.x + 11, y: station.y - 10, anchor: 'start', fontSize: 14 };
        const englishName = plannedById.get(station.id)?.englishName ?? englishNames[station.id] ?? '';
        return <text class:list={['station-label', { planned: 'status' in station && station.status === 'planned' }]} data-label={station.id} x={label.x} y={label.y} text-anchor={label.anchor} font-size={label.fontSize}><tspan>{station.name}</tspan>{englishLines(englishName).map(name => <tspan class="station-label-en" x={label.x} dy="9" font-size="8" lang="en">{name}</tspan>)}</text>;
      })}
    </g>
</svg>
  <div id="geographic-map" aria-label={`${city.name}地铁真实地图，可拖动和缩放`}></div>
  <div class="vector-attribution"><a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">© OpenStreetMap contributors</a> · <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">CC BY 4.0</a> <a href="https://esa-worldcover.org/en/data-access" target="_blank" rel="noopener noreferrer">ESA WorldCover 2021</a> · <a href="https://versatiles.org/" target="_blank" rel="noopener noreferrer">© VersaTiles</a></div>
  <p id="map-status" class="map-status" role="status">地图加载中…</p>
  <div class="map-tools">
    <div class="search-panel">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg>
      <input id="station-search" type="search" placeholder="搜索地铁站" aria-label={`搜索${city.name}地铁站`} autocomplete="off" aria-controls="search-results" />
      <kbd>/</kbd>
      <div id="search-results" class="search-results" hidden></div>
    </div>
    <details class="line-panel">
      <summary><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5h14M5 12h14M5 19h14"/><circle cx="9" cy="5" r="2"/><circle cx="15" cy="12" r="2"/><circle cx="9" cy="19" r="2"/></svg><span>线路站点</span><span id="line-count">全部</span><svg class="chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="m5 6 3 3 3-3"/></svg></summary>
      <div class="line-options"><button id="all-lines" class="line-choice active" type="button" aria-pressed="true">全部线路</button>{lines.map(line => <button class="line-choice" type="button" data-line={line.id} aria-label={line.name} aria-pressed="false"><img class="line-badge" src={`${city.assetBase}/lines/${line.id}.svg`} alt={line.name} width={lineBadgeWidth(line.id)} height="100" /></button>)}</div>
    </details>
    <div class="map-mode" role="group" aria-label="地图显示方式">
      <button type="button" data-map-view="vector" aria-pressed="false">矢量</button>
      <button type="button" data-map-view="geographic" aria-pressed="true">地图</button>
    </div>
  </div>
  <aside id="station-card" class="station-card" aria-live="polite" hidden>
    <div class="card-top"><div><span class="eyebrow">地铁站</span><h1 id="station-name"></h1></div><button id="close-card" class="icon-button" aria-label="关闭站点详情"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div>
    <p id="station-english" class="station-english" lang="en"></p>
    <div id="station-lines" class="station-lines"></div>
    <div id="station-operators" class="station-operators" aria-label="线路运营公司"></div>
    <p id="station-visit-status" class="station-status" hidden>已去过</p>
    <p id="station-location-status" class="station-status" hidden></p>
    <p id="station-note" class="station-note" hidden></p>
  </aside>
  <div class="zoom-controls" aria-label="地图缩放">
    <button id="zoom-in" aria-label="放大地图" title="放大"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button>
    <span id="zoom-level" title="当前地图缩放级别">…</span>
    <button id="zoom-out" aria-label="缩小地图" title="缩小"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"/></svg></button>
    <button id="reset-map" aria-label="重置地图视野" title="重置视野"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 4H4v4M16 4h4v4M20 16v4h-4M8 20H4v-4"/><circle cx="12" cy="12" r="3"/></svg></button>
  </div>
  <div id="map-tooltip" class="map-tooltip" hidden></div>
</section>
<script define:vars={{ metroPayload }}>
  window.__metroData = JSON.parse(metroPayload);
</script>
<script src="./map.ts"></script>
